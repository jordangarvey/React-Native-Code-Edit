{
	"name": "react-native-code-edit",
	"version": "1.0.0",
	"description": "A lightweight code editor for React Native",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jordangarvey/React-Native-Code-Edit.git"
	},
	"homepage": "https://github.com/jordangarvey/React-Native-Code-Edit#readme",
	"author": {
		"name": "Jordan Garvey",
		"email": "jordan.garvey@icloud.com"
	},
	"license": "MIT",
	"private": false,
	"keywords": [
		"react-native",
		"reactjs",
		"reactnative",
		"code",
		"code-editor",
		"editor",
		"syntax-highlighting"
	],
	"bugs": {
		"email": "jordan.garvey@icloud.com",
		"url": "https://github.com/jordangarvey/React-Native-Code-Edit/issues"
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && tsc",
		"typecheck": "tsc --noEmit",
		"pretest": "npm run build",
		"test": "node --test \"test/**/*.test.js\"",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-native": ">=0.71.0"
	},
	"devDependencies": {
		"@types/react": "^19.2.18",
		"react": "^19.2.8",
		"react-native": "^0.87.0",
		"typescript": "^5.9.3"
	}
}
